{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "wa-state": false
    }
  },
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/(lib|tests|tools|docs|node_modules)(/.*)?", "status": 404 },
    { "src": "/(package\\.json|package-lock\\.json|vercel\\.json|README\\.txt)", "status": 404 },
    {
      "src": "/data/(.*)",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    }
  ]
}
